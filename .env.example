# Copy to .env and fill in. .env is never committed.

# How model calls run:
#   replay  use the recorded responses in fixtures/ (no keys, no cost, same result every time)
#   live    call the models
#   record  call the models and save their responses to fixtures/
ATLAS_MODE=replay

# --- OpenRouter (chat models and embeddings) -----------------------------------------
# Key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The model that writes answers. Any OpenRouter model id.
ATLAS_CHAT_MODEL=
# Free on OpenRouter. Free endpoints may keep what you send: fine for the fictional
# Atlas Bikes corpus, not for real company documents.
ATLAS_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free

# --- Alternative embeddings: Gemini through Google AI Studio (free tier) -----------------
# Key from https://aistudio.google.com/apikey . Set ATLAS_EMBED_PROVIDER=gemini to use it.
ATLAS_EMBED_PROVIDER=openrouter
GOOGLE_API_KEY=
ATLAS_GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Postgres (compose.yaml) ------------------------------------------------------------
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
POSTGRES_PORT=54329
DATABASE_URL=postgresql://atlas:atlas@localhost:54329/atlas
