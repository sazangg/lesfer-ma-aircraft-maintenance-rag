# Copy to .env and fill in. .env is never committed.

# How model calls run:
#   replay  use the recorded responses in fixtures/ (no keys, no cost, same result every time)
#   live    call the models
#   record  call the models and save their responses to fixtures/
ANFA_MODE=replay

# --- OpenRouter (chat models and embeddings) -----------------------------------------
# Key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The model that writes answers. Any OpenRouter model id.
ANFA_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Free on OpenRouter. Free endpoints may keep what you send: fine for the FAA documents and
# the fictional Anfa layer, not for real company documents.
ANFA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
# Describes figures during ingestion (Part 3): one request per figure, 171 in this corpus.
ANFA_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Postgres (compose.yaml) ------------------------------------------------------------
POSTGRES_USER=anfa
POSTGRES_PASSWORD=anfa
POSTGRES_DB=anfa
POSTGRES_PORT=54329
DATABASE_URL=postgresql://anfa:anfa@localhost:54329/anfa
