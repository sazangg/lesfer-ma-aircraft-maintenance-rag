    {
      "id": "e6",
      "type": "paragraph",
      "page": 1,
      "text": "100-hour inspection per 14 CFR 91.409(b), using the Cessna 172 inspection checklist."
    },
    {
      "id": "e7",
      "type": "paragraph",
      "page": 1,
      "text": "Changed engine oil and filter. Compression check, cylinders 1 to 4: 73/80, 70/80, 77/80, 70/80."
    },
    {
      "id": "e8",
      "type": "paragraph",
      "page": 1,
      "text": "Discrepancy: Induction air filter dirty. Corrective action: Replaced induction air filter."
    },
    {
      "id": "e9",
      "type": "paragraph",
      "page": 1,
      "text": "Discrepancy: Spark plugs worn beyond limits. Corrective action: Replaced all eight spark plugs."
    },
    {
      "id": "e10",
      "type": "paragraph",
      "page": 1,
      "text": "Discrepancy: Right main tire worn to the wear limit. Corrective action: Replaced right main tire."
    },
    {
      "id": "e11",
      "type": "paragraph",
      "page": 1,
      "text": "Aircraft found airworthy after correction of the discrepancies listed."
    },
