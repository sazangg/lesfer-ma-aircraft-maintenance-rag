    {
      "id": "e6",
      "type": "paragraph",
      "page": 1,
      "text": "100-hour inspection per 14 CFR 91.409(b), using the Cessna 172 inspection checklist."
    },
    {
      "id": "e7",
      "type": "paragraph",
      "page": 1,
      "text": "Changed engine oil and filter. Compression check, cylinders 1 to 4: 75/80, 72/80, 72/80, 76/80."
    },
    {
      "id": "e8",
      "type": "paragraph",
      "page": 1,
      "text": "Discrepancy: Left brake linings at minimum thickness. Corrective action: Replaced left brake linings."
    },
    {
      "id": "e9",
      "type": "paragraph",
      "page": 1,
      "text": "Discrepancy: Induction air filter dirty. Corrective action: Replaced induction air filter."
    },
    {
      "id": "e10",
      "type": "paragraph",
      "page": 1,
      "text": "Discrepancy: Nose strut extension low. Corrective action: Serviced nose strut with hydraulic fluid and air."
    },
    {
      "id": "e11",
      "type": "paragraph",
      "page": 1,
      "text": "Aircraft found airworthy after correction of the discrepancies listed."
    },
