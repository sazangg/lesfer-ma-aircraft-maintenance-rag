    {
      "id": "e6",
      "type": "paragraph",
      "page": 1,
      "text": "100-hour inspection per 14 CFR 91.409(b), using the Cessna 172 inspection checklist."
    },
    {
      "id": "e7",
      "type": "paragraph",
      "page": 1,
      "text": "Changed engine oil and filter. Compression check, cylinders 1 to 4: 71/80, 75/80, 75/80, 75/80."
    },
    {
      "id": "e8",
      "type": "paragraph",
      "page": 1,
      "text": "Discrepancy: Induction air filter dirty. Corrective action: Replaced induction air filter."
    },
    {
      "id": "e9",
      "type": "paragraph",
      "page": 1,
      "text": "Discrepancy: Alternator belt tension low. Corrective action: Adjusted alternator belt tension per maintenance manual."
    },
    {
      "id": "e10",
      "type": "paragraph",
      "page": 1,
      "text": "Discrepancy: Corrosion on battery box. Corrective action: Removed corrosion, treated and painted battery box; neutralized battery area."
    },
    {
      "id": "e11",
      "type": "paragraph",
      "page": 1,
      "text": "Aircraft found airworthy after correction of the discrepancies listed."
    },
